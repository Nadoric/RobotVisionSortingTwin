<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <UseWPF>true</UseWPF>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <PlatformTarget>x64</PlatformTarget>
        <AssemblyTitle>机器人视觉分拣三维数字孪生沙盘</AssemblyTitle>
        <Version>1.0.0</Version>
        <ApplicationIcon>Assets\TwinIcon.ico</ApplicationIcon>
        <DefaultItemExcludes>$(DefaultItemExcludes);artifacts/**;tests/**</DefaultItemExcludes>
    </PropertyGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="RobotVisionSortingTwin.Verify" />
        <Resource Include="Assets\TwinIcon.ico" />
        <Resource Include="Assets\TwinIcon.png" />
    </ItemGroup>
</Project>
